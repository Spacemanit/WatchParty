{"nodes": [{"id": "testing_first_edition_verification", "label": "First-edition verification record", "file_type": "document", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "_origin": "semantic"}, {"id": "testing_protocol_verification", "label": "Thirteen HTTP and Socket.IO integration tests", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests run on one Windows computer with Node.js 24.16.0 using real loopback sockets. Ten-user checks mean one host and nine protocol clients, not ten decoding players or physical devices. Synthetic upload bytes verify streaming and authorization rather than decoding. Six chat cases bring the suite to thirteen tests and check that messaging preserves playback sequence and revision.", "_origin": "semantic"}, {"id": "testing_original_browser_verification", "label": "Original-layout two-tab browser verification", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The original interface was checked with two independent browser tabs for room creation, invitation joins, refresh restoration, host transfer, local WebM, shared playback commands, YouTube and disabled guest controls. A 375-pixel guest viewport had no horizontal overflow. These checks apply to the original interface.", "_origin": "semantic"}, {"id": "testing_revised_ui_verification_gap", "label": "Revised layout and chat browser-verification gap", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The e-ink revision and chat have passing integration/syntax checks, and static checks resolve page references, SVG symbols and labels. Browser security policy blocked visual/interaction inspection of the revised layout; the chat panel and emoji picker remain visually unverified. Normal-browser checks are still required.", "_origin": "semantic"}, {"id": "testing_manual_lan_acceptance", "label": "Physical-device LAN acceptance checklist", "file_type": "rationale", "source_file": "TESTING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pending manual acceptance covers reachable LAN invites, real playable media, late joins/reconnects, host transfer, autoplay and embed failures, ten actual browser participants, guest permissions, failure recovery, mobile/keyboard use and chat interactions. Protocol tests cannot establish ten-stream capacity; latency and player drift require a separate physical-device benchmark.", "_origin": "semantic"}], "edges": [{"source": "testing_first_edition_verification", "target": "testing_protocol_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "TESTING.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "testing_first_edition_verification", "target": "testing_original_browser_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "TESTING.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "testing_first_edition_verification", "target": "testing_revised_ui_verification_gap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "TESTING.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "testing_first_edition_verification", "target": "testing_manual_lan_acceptance", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "TESTING.md", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "testing_protocol_verification